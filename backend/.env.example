# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB connection string (MongoDB Atlas free tier, or local mongodb://localhost:27017/leaddesk)
MONGODB_URI=your_mongodb_connection_string_here

# Secret used to sign admin JWT sessions - use a long random string
JWT_SECRET=replace_with_a_long_random_string

# Port the API listens on (Render sets this automatically in production)
PORT=5000

# Used ONLY once, by seedAdmin.js, to create the first admin account in the database.
# The password is hashed before being stored - it is never kept in plain text anywhere.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
